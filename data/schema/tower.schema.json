{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bloons-ml/tower.schema.json",
  "title": "Normalisierter BTD6-Turm (data/base/towers/<id>.json)",
  "description": "Pro Tier ein vollständiger Zustand mit Absolutwerten. Nicht modellierte Mechaniken stehen unverändert in `effects`.",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "cost",
    "placement",
    "footprint",
    "game_version",
    "sources",
    "base",
    "paths"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "enum": [
        "primary",
        "military",
        "magic",
        "support"
      ]
    },
    "cost": {
      "type": "integer",
      "minimum": 0,
      "description": "Medium"
    },
    "placement": {
      "enum": [
        "land",
        "water",
        "land_or_water"
      ]
    },
    "footprint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "radius"
          ],
          "additionalProperties": false,
          "properties": {
            "radius": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "rect"
          ],
          "additionalProperties": false,
          "properties": {
            "rect": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    },
    "game_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abilities": {
      "type": "array"
    },
    "base": {
      "$ref": "#/$defs/state"
    },
    "paths": {
      "type": "object",
      "required": [
        "top",
        "middle",
        "bottom"
      ],
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/$defs/path"
        },
        "middle": {
          "$ref": "#/$defs/path"
        },
        "bottom": {
          "$ref": "#/$defs/path"
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "tier",
          "name",
          "cost",
          "ops",
          "state",
          "effects"
        ],
        "additionalProperties": false,
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "name": {
            "type": "string"
          },
          "cost": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Medium"
          },
          "description": {
            "type": "string"
          },
          "state": {
            "$ref": "#/$defs/state"
          },
          "effects": {
            "type": "object",
            "description": "Nicht modellierte Änderungen dieses Tiers, unverändert aus raw/"
          },
          "ops": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/op"
            },
            "description": "Änderungen dieses Tiers gegenüber dem vorherigen; Quelle für die Modifier der Engine"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "range",
        "camo",
        "reach",
        "attacks"
      ],
      "additionalProperties": false,
      "properties": {
        "range": {
          "type": [
            "number",
            "null"
          ]
        },
        "camo": {
          "type": "boolean"
        },
        "reach": {
          "enum": [
            "radius",
            "global",
            "reticle",
            "flying",
            "follow"
          ]
        },
        "attacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attack"
          }
        }
      }
    },
    "attack": {
      "type": "object",
      "required": [
        "tag",
        "name",
        "damage",
        "pierce",
        "cooldown",
        "damage_type",
        "projectiles",
        "blast_radius",
        "range",
        "projectile_speed",
        "lifespan",
        "damage_vs",
        "camo"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string"
        },
        "damage": {
          "type": [
            "number",
            "null"
          ]
        },
        "pierce": {
          "type": [
            "number",
            "null"
          ]
        },
        "cooldown": {
          "type": [
            "number",
            "null"
          ],
          "description": "Sekunden"
        },
        "damage_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "sharp",
            "normal",
            "explosive",
            "energy",
            "plasma",
            "shatter",
            "acid",
            "fire",
            "frigid",
            "cold",
            "glacier"
          ]
        },
        "projectiles": {
          "type": [
            "number",
            "null"
          ]
        },
        "blast_radius": {
          "type": [
            "number",
            "null"
          ]
        },
        "projectile_speed": {
          "type": [
            "number",
            "null"
          ]
        },
        "lifespan": {
          "type": [
            "number",
            "null"
          ]
        },
        "damage_vs": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "pattern": "^(?:bad|bfb|boss|burning|camo|ceramic|ddt|fortified|frozen|glued|lead|moab|purple|shocked|stickied|stunned|zomg)(\\+(?:bad|bfb|boss|burning|camo|ceramic|ddt|fortified|frozen|glued|lead|moab|purple|shocked|stickied|stunned|zomg))*$"
          },
          "description": "Bonus-Schaden je Bloon-/Status-Klasse; 'a+b' = beide Bedingungen (z.B. fortified+moab)"
        },
        "camo": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "null = wie der Turm; false nur als explizite Ausnahme (Turm hat Camo, Angriff nicht)"
        },
        "notes": {
          "type": "string"
        },
        "range": {
          "type": [
            "number",
            "null"
          ],
          "description": "nur gesetzt, wenn abweichend von der Turm-Range (RangeOverride)"
        }
      }
    },
    "op": {
      "type": "object",
      "required": [
        "target",
        "stat",
        "op",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "description": "'tower' oder Angriffs-tag"
        },
        "stat": {
          "enum": [
            "range",
            "camo",
            "damage",
            "pierce",
            "cooldown",
            "damage_type",
            "projectiles",
            "blast_radius",
            "projectile_speed",
            "lifespan",
            "damage_vs",
            "attack"
          ]
        },
        "op": {
          "enum": [
            "set",
            "add",
            "mul",
            "remove"
          ]
        },
        "value": {}
      }
    }
  }
}
